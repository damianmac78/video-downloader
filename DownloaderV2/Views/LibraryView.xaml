<UserControl x:Class="DownloaderV2.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="MUSIC LIBRARY" Style="{StaticResource SectionHeader}" />
            <Grid Grid.Row="1" Margin="0,10,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search title, artist or album" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" Style="{StaticResource DarkComboBox}" />
            </Grid>
            <ListView x:Name="TrackList" Grid.Row="2" ItemsSource="{Binding TracksView}" SelectedItem="{Binding SelectedTrack}"
                      MouseDoubleClick="TrackList_OnMouseDoubleClick">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Width="48">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="36" Height="36" Background="#0E1215" CornerRadius="2" ClipToBounds="True">
                                        <Image Source="{Binding ArtworkPath}" Stretch="UniformToFill" />
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="210" />
                        <GridViewColumn Header="Artist" DisplayMemberBinding="{Binding Artist}" Width="150" />
                        <GridViewColumn Header="Time" DisplayMemberBinding="{Binding DurationText}" Width="65" />
                    </GridView>
                </ListView.View>
            </ListView>
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Play" Command="{Binding PlayCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Add to Playlist" Command="{Binding AddToPlaylistCommand}" Margin="6,0,0,0" />
                    <Button Content="Discover Similar" Command="{Binding DiscoverCommand}" Margin="6,0,0,0" />
                    <Button Content="Delete…" Click="DeleteTrack_OnClick" Margin="6,0,0,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="260" />
            </Grid>
        </Grid>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
            <Grid DataContext="{Binding Playlists}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="115" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="PLAYLISTS" Style="{StaticResource SectionHeader}" />
                <Grid Grid.Row="1" Margin="0,8,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding PlaylistName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Playlist name" Margin="0,0,5,0" />
                    <Button Grid.Column="1" Content="New" Command="{Binding CreateCommand}" />
                </Grid>
                <ListBox Grid.Row="2" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}" DisplayMemberPath="Name" />
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6">
                    <Button Content="Rename" Command="{Binding RenameCommand}" />
                    <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="5,0,0,0" />
                </StackPanel>
                <ListBox Grid.Row="4" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" DisplayMemberPath="Title" />
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,6">
                    <Button Content="Play" Command="{Binding PlayCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="All" Command="{Binding PlayAllCommand}" Margin="5,0,0,0" />
                    <Button Content="Shuffle" Command="{Binding ShuffleCommand}" Margin="5,0,0,0" />
                </StackPanel>
                <Grid Grid.Row="6">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Up" Command="{Binding MoveUpCommand}" />
                        <Button Content="Down" Command="{Binding MoveDownCommand}" Margin="5,0,0,0" />
                        <Button Content="Remove" Command="{Binding RemoveTrackCommand}" Margin="5,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,32,0,0" TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
