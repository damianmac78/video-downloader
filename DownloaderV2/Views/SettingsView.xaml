<UserControl x:Class="DownloaderV2.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="SETTINGS" Style="{StaticResource SectionHeader}"/>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Last.fm recommendations" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Last.fm supplies similar-track metadata only. Downloads still use yt-dlp and require your confirmation."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12"/>
                <TextBlock Text="Last.fm API Key" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Width="500" HorizontalAlignment="Left"
                         ToolTip="Stored only in your local DownloaderV2 settings"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Save" Command="{Binding SaveCommand}"/>
                    <Button Content="Test Connection" Command="{Binding TestConnectionCommand}" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
                    <Button Content="Get Last.fm API key" Command="{Binding OpenApiKeyPageCommand}" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Radio Mode" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Temporary recommendations are stored in the Radio Cache until you choose Keep."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="80"/><ColumnDefinition Width="150"/><ColumnDefinition Width="80"/><ColumnDefinition Width="140"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Preload tracks"/><TextBox Grid.Column="1" Text="{Binding RadioPreloadCount}"/>
                    <TextBlock Grid.Column="2" Text="Max age (days)" Margin="12,0,0,0"/><TextBox Grid.Column="3" Text="{Binding RadioCacheMaxAgeDays}"/>
                    <TextBlock Grid.Column="4" Text="Max size (GB)" Margin="12,0,0,0"/><TextBox Grid.Column="5" Text="{Binding RadioCacheMaxSizeGb}"/>
                </Grid>
                <Button Content="Save Radio Settings" Command="{Binding SaveRadioCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
