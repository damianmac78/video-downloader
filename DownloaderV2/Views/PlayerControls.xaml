<UserControl x:Class="DownloaderV2.Views.PlayerControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DownloaderV2.Controls">
    <Border Background="#161B20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,9">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" Background="#0E1215" CornerRadius="3" ClipToBounds="True">
                <Image Source="{Binding CurrentTrack.ArtworkPath, Converter={StaticResource NullableImageSourceConverter}}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0">
                <TextBlock Text="{Binding CurrentTrack.Title, TargetNullValue=Nothing playing}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CurrentTrack.Artist, TargetNullValue=Choose a track from Library}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Prev" Command="{Binding PreviousCommand}" Style="{StaticResource PlayerButton}" />
                <Button Content="{Binding PlayPauseText}" Command="{Binding PlayPauseCommand}" Style="{StaticResource PlayerButton}" Margin="4,0" MinWidth="54" />
                <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource PlayerButton}" />
                <Button Content="Next" Command="{Binding NextCommand}" Style="{StaticResource PlayerButton}" Margin="4,0,0,0" ToolTip="Play the next track or skip to the next queued item" />
            </StackPanel>
            <Grid Grid.Column="3" Margin="12,0">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <controls:VisualizerControl Frame="{Binding AudioFrame}" RendererName="Classic Spectrum Bars"
                                            ArtworkPath="{Binding CurrentTrack.ArtworkPath}" Height="40" />
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ElapsedText}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                    <Slider Grid.Column="1" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,0" />
                    <TextBlock Grid.Column="2" Text="{Binding RemainingText}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Visualiser" Command="{Binding OpenVisualizerCommand}" Style="{StaticResource PlayerButton}" Margin="0,0,4,0" AutomationProperties.Name="Open Visualiser" />
                    <Button Content="{Binding RadioText}" Command="{Binding ToggleRadioCommand}" Style="{StaticResource PlayerButton}" Margin="0,0,4,0" ToolTip="{Binding RadioStatus}" />
                    <Button Content="{Binding QueueText}" Command="{Binding OpenQueueCommand}" Style="{StaticResource PlayerButton}" Margin="0,0,4,0" />
                    <Button Content="Keep" Command="{Binding KeepTrackCommand}" Style="{StaticResource PlayerButton}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Content="{Binding ShuffleText}" Command="{Binding ToggleShuffleCommand}" Style="{StaticResource PlayerButton}" />
                    <Button Content="{Binding RepeatText}" Command="{Binding ToggleRepeatCommand}" Style="{StaticResource PlayerButton}" Margin="4,0,0,0" />
                    <TextBlock Text="Volume" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="12,0,5,0" />
                    <Slider Width="90" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
