<Window x:Class="DownloaderV2.Views.QueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Playback Queue" Width="760" Height="520" MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Assets/DownloaderV2.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="UP NEXT" Style="{StaticResource SectionHeader}"/><TextBlock Text="Radio tracks stay temporary until you choose Keep." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
        <ListView Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="0,12,0,0">
            <ListView.View><GridView AllowsColumnReorder="False">
                <GridViewColumn Width="58"><GridViewColumn.CellTemplate><DataTemplate><Border Width="44" Height="30" Background="#0E1215"><Image Source="{Binding ArtworkPath, Converter={StaticResource NullableImageSourceConverter}}" Stretch="UniformToFill"/></Border></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="260"/>
                <GridViewColumn Header="Artist" DisplayMemberBinding="{Binding Artist}" Width="170"/>
                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding StatusText}" Width="125"/>
                <GridViewColumn Header="Source" DisplayMemberBinding="{Binding RadioText}" Width="70"/>
            </GridView></ListView.View>
        </ListView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Play Now" Command="{Binding PlayNowCommand}" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Keep" Command="{Binding KeepCommand}" Margin="6,0,0,0"/>
            <Button Content="Remove" Command="{Binding RemoveCommand}" Margin="6,0,0,0"/>
            <Button Content="Move Up" Command="{Binding MoveUpCommand}" Margin="6,0,0,0"/>
            <Button Content="Move Down" Command="{Binding MoveDownCommand}" Margin="6,0,0,0"/>
            <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource DangerButton}" Margin="6,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
