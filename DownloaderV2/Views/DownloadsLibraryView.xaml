<UserControl x:Class="DownloaderV2.Views.DownloadsLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="DOWNLOAD LIBRARY" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Video and audio files downloaded by DownloaderV2" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
        <ListView Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="390"/>
                    <GridViewColumn Header="Type" DisplayMemberBinding="{Binding MediaType}" Width="80"/>
                    <GridViewColumn Header="Format" DisplayMemberBinding="{Binding Extension}" Width="75"/>
                    <GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeText}" Width="95"/>
                    <GridViewColumn Header="Downloaded / Modified" DisplayMemberBinding="{Binding ModifiedText}" Width="150"/>
                    <GridViewColumn Header="Folder" DisplayMemberBinding="{Binding Folder}" Width="340"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Grid Grid.Row="2" Margin="0,9,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Open" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Open Folder" Command="{Binding OpenFolderCommand}" Margin="6,0,0,0"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
