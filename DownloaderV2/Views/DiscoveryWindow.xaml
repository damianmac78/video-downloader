<Window x:Class="DownloaderV2.Views.DiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discover Similar Music" Width="920" Height="650" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Assets/DownloaderV2.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="DISCOVER SIMILAR" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="{Binding SourceDescription}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,2"/>
            <TextBlock Text="Recommendations powered by Last.fm. Nothing is downloaded until you explicitly choose it." Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
        </StackPanel>
        <ListView Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" Margin="0,12,0,0"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View><GridView AllowsColumnReorder="False">
                <GridViewColumn Width="82"><GridViewColumn.CellTemplate><DataTemplate><Border Width="68" Height="42" Background="#0E1215"><Image Source="{Binding ThumbnailUrl, Converter={StaticResource NullableImageSourceConverter}}" Stretch="UniformToFill"/></Border></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="315"/>
                <GridViewColumn Header="Artist" DisplayMemberBinding="{Binding Artist}" Width="170"/>
                <GridViewColumn Header="Time" DisplayMemberBinding="{Binding DurationText}" Width="65"/>
                <GridViewColumn Header="Match" DisplayMemberBinding="{Binding SimilarityText}" Width="65"/>
                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="135"/>
            </GridView></ListView.View>
        </ListView>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Download to Music" Command="{Binding DownloadCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Play" Command="{Binding PlayCommand}" Margin="6,0,0,0"/>
                <Button Content="Add to Playlist" Command="{Binding AddToPlaylistCommand}" Margin="6,0,0,0"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" Margin="6,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Grid Width="16" Height="16" Margin="0,0,7,0"
                      Visibility="{Binding IsDiscovering, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="2.2" StrokeDashArray="1.5,2.2"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.8"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="370"/>
            </StackPanel>
        </Grid>
        <Expander Grid.Row="3" Header="Technical details" Margin="0,8,0,0"
                  Visibility="{Binding HasTechnicalDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBox Text="{Binding TechnicalDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto"/>
        </Expander>
    </Grid>
</Window>
